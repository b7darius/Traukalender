# Konfiguration des Traukalender-Monitors.
# Kopieren nach .env und mit "set -a; . ./.env; set +a" laden.
# .env ist per .gitignore ausgeschlossen.

# --- Was wird beobachtet ---
TK_MONATE=2027-08
TK_TRAUORTE=alle
TK_INTERVAL=900

# --- Push aufs Handy via ntfy (empfohlen, keine Anmeldung noetig) ---
# Zufaelliges Topic waehlen und in der ntfy-App abonnieren.
TK_NTFY_TOPIC=
# TK_NTFY_SERVER=https://ntfy.sh
# TK_NTFY_TOKEN=

# --- E-Mail ---
# TK_SMTP_HOST=smtp.gmail.com
# TK_SMTP_PORT=587
# TK_SMTP_USER=
# TK_SMTP_PASS=
# TK_MAIL_FROM=
# TK_MAIL_TO=

# --- Telegram ---
# TK_TELEGRAM_TOKEN=
# TK_TELEGRAM_CHAT=

# --- Beliebiger Webhook ---
# TK_WEBHOOK_URL=
