# Konfiguration des Traukalender-Monitors.
# Kopieren nach .env und mit "set -a; . ./.env; set +a" laden.
# .env ist per .gitignore ausgeschlossen.

# --- Was wird beobachtet ---
TK_MONATE=2027-08
TK_TRAUORTE=alle
TK_INTERVAL=900

# --- Push aufs Handy via ntfy (empfohlen, keine Anmeldung noetig) ---
# Zufaelliges Topic waehlen und in der ntfy-App abonnieren.
TK_NTFY_TOPIC=
# TK_NTFY_SERVER=https://ntfy.sh
# TK_NTFY_TOKEN=

# --- E-Mail ---
# TK_SMTP_HOST=smtp.gmail.com
# TK_SMTP_PORT=587
# TK_SMTP_USER=
# TK_SMTP_PASS=
# TK_MAIL_FROM=
# TK_MAIL_TO=

# --- Telegram ---
# TK_TELEGRAM_TOKEN=
# TK_TELEGRAM_CHAT=

# --- Beliebiger Webhook ---
# TK_WEBHOOK_URL=

# --- Automatische Reservierung (traukalender_buchung.py) ---
# Scharfschalter. Ohne diese 1 wird nie reserviert.
# TK_BUCHUNG_AKTIV=1
# TK_BUCHUNG_MONATE=2027-08
# TK_BUCHUNG_TRAUORTE=1210,1345          # Kurhaus, Casino-Gesellschaft
# TK_BUCHUNG_WOCHENTAGE=samstag

# Personendaten als ein JSON. In GitHub Actions als Secret TK_PERSONENDATEN
# hinterlegen - niemals in eine Datei im Repository schreiben.
# TK_PERSONENDATEN={"partner1":{"anrede":"frau","vorname":"","name":"","strasse":"","plz":"","ort":"","land":"DE","staat":"deutsch"},"partner2":{"anrede":"herr","vorname":"","name":"","strasse":"","plz":"","ort":"","land":"DE","staat":"deutsch"},"kontakt":{"email":"","telefon":""}}
